generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  fullName         String    @map("full_name")
  email            String    @unique
  password         String
  username         String?   @unique
  phone            String?
  role             String
  twoFactorEnabled Boolean?  @default(true) @map("two_factor_enabled")
  twoFactorCode    String?   @map("two_factor_code")
  twoFactorExpiry  DateTime? @map("two_factor_expiry")
  approved         Boolean   @default(false)
  profileImage     String?   @map("profile_image")
  locationId       String?   @map("location_id") @db.Uuid
  location         Location? @relation(fields: [locationId], references: [id])
  member           Member?
  passwordResetToken PasswordResetToken?

  @@map("users")
}

model Member {
  id               String       @id @default(uuid()) @db.Uuid
  address          String?
  phoneNumber      String?      @map("phone_number")
  membershipStatus String       @map("membership_status")
  userId           String       @unique @map("user_id") @db.Uuid
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendances      Attendance[]

  @@map("members")
}

model Event {
  id          String       @id @default(uuid()) @db.Uuid
  eventName   String       @map("event_name")
  eventDate   DateTime     @map("event_date") @db.Date
  location    String
  description String?
  coverImage  String?      @map("cover_image")
  time        String?      @map("event_time")
  attendances Attendance[]

  @@map("events")
}

model Attendance {
  id       String  @id @default(uuid()) @db.Uuid
  memberId String  @map("member_id") @db.Uuid
  eventId  String  @map("event_id") @db.Uuid
  present  Boolean @default(false)
  member   Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  event    Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([memberId, eventId])
  @@map("attendance")
}

model News {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  content     String    @db.Text
  author      String?
  publishDate DateTime  @default(now()) @map("publish_date")
  type        String?
  coverImage  String?   @map("cover_image")

  @@map("news")
}

model Resource {
  id          String  @id @default(uuid()) @db.Uuid
  title       String
  description String? @db.VarChar(1000)
  fileUrl     String  @map("file_url")
  category    String?

  @@map("resources")
}

model Location {
  id       String     @id @default(uuid()) @db.Uuid
  code     String?    @unique
  name     String
  level    String?
  parentId String?    @map("parent_id") @db.Uuid
  parent   Location?  @relation("LocationTree", fields: [parentId], references: [id])
  children Location[] @relation("LocationTree")
  users    User[]

  @@map("locations")
}

model Achievement {
  id              String  @id @default(uuid()) @db.Uuid
  title           String
  category        String
  currentProgress Float   @map("current_progress")
  targetValue     Float   @map("target_value")
  unit            String
  description     String? @db.VarChar(1000)
  yearLabel       String? @map("year_label")

  @@map("achievements")
}

model PasswordResetToken {
  id         String   @id @default(uuid()) @db.Uuid
  token      String   @unique
  userId     String   @unique @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiryDate DateTime @map("expiry_date")

  @@map("password_reset_tokens")
}
